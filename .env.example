# ========================================================
# CONFIGURAÇÕES DO STUDY HUB & LIFE OS
# ========================================================

# 1. Chave da API do Google Gemini (IA para resumos e flashcards)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Configurações de Backup no Google Drive (Opção 2 - API Oficial)
GOOGLE_DRIVE_SYNC_ENABLED=true
GOOGLE_DRIVE_FOLDER_NAME=Study Hub - Backup
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
